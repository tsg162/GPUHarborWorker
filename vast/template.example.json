{
  "name": "GPUHarbor training",
  "image": "YOUR_REGISTRY/gpuharbor-worker:0.2.0",
  "runtype": "ssh",
  "ssh_direct": true,
  "env": "-e GPUHARBOR_SERVER_NAME=gpu1 -e GPUHARBOR_PORT=5000 -e GPUHARBOR_HOST=127.0.0.1 -e GPUHARBOR_STORAGE_ROOT=/workspace/gpuharbor -e GPUHARBOR_CACHE_ROOT=/workspace/gpuharbor-cache -e GPUHARBOR_TRAINING_PYTHON=/venv/main/bin/python",
  "onstart": "bash /opt/GPUHarborWorker/vast/onstart.sh"
}
